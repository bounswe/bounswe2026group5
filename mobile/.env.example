# ==============================================================================
# MOBILE SPECIFIC (Expo / React Native)
# ==============================================================================
#
# API base URL — choose the value that matches your run target:
#
#   Android emulator (default):   http://10.0.2.2:8000
#   iOS simulator:                http://localhost:8000
#   Physical device (same Wi-Fi): http://<YOUR_MACHINE_IP>:8000
#
# To find your machine IP run: hostname -I (Linux/macOS) or ipconfig (Windows).
# Also add that IP to ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS in the root .env.
#
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Google OAuth (optional — leave empty to disable Google sign-in)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Config (optional — leave empty to fall back to HTTP polling)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=