# ==============================================================================
# BACKEND SPECIFIC (Django Secrets & Infrastructure)
# ==============================================================================
SECRET_KEY=replace-with-a-secure-secret-key
DATABASE_URL=postgres://admin:change-me@db:5432/mentorship

# Feature Flags
REQUIRE_EMAIL_VERIFICATION=False

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=

# External Auth & Storage
GOOGLE_OAUTH_CLIENT_ID=

# Initial Admin Seeding
# These values are read by migration 0015_seed_admin_profile to create the admin user.
# After running `python manage.py migrate`, log in with these credentials.
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=AdminPass123!

