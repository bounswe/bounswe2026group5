# ==========================================
# OS & Editor
# ==========================================
.DS_Store
.DS_Store?
._*
.Trashes
Thumbs.db
ehthumbs.db
.idea/
*.swp
*.swo
*~

# Ignore local VSCode caches, but keep shared settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ==========================================
# Environment Variables
# ==========================================
# (Note: .env.example files are intentionally NOT ignored, they must be tracked)
.env
.env.local
*.local
!.env.example
**/.env*.local

# ==========================================
# Python / Django
# ==========================================
**/.venv/
**/venv/

# Compiled Python Files
**/__pycache__/
*.py[cod]
*$py.class

# Database and Media (Development Environment)
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/message_attachments/
backend/staticfiles/

# Testing and Logs
.pytest_cache/
htmlcov/
.coverage
*.log

# ==========================================
# Node / Frontend
# ==========================================
**/node_modules/

# Build Outputs
web/dist/
web/dist-ssr/
web/build/
web/.output/
mobile/dist/
mobile/web-build/

